# Portfolio Backend Environment Variables

# Application
APP_NAME=Portfolio API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Frontend URL (comma separated for multiple)
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://durangezer.dev

# Database
DATABASE_URL=sqlite+aiosqlite:///./portfolio.db

# AI - Groq (server only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
CHAT_TIMEOUT_SECONDS=20
CHAT_MAX_CONCURRENCY=4
CHAT_REQUESTS_PER_MINUTE=60
CHAT_REQUESTS_PER_DAY=1000
CHAT_SESSION_TTL_SECONDS=1800
CHAT_MAX_SESSIONS=500

# Email - Resend
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=your_email@example.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Admin API Key (for protected endpoints)
ADMIN_API_KEY=your_admin_api_key_here
